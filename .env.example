# Qahal Environment Variables
# Copy this file to .env and fill in all values before deploying.

# =============================================================================
# Telegram Bot Tokens
# Get these from @BotFather on Telegram.
# Each bot (test + production) needs its own token.
# =============================================================================
TELEGRAM_BOT_TOKEN_TEST=
TELEGRAM_BOT_TOKEN_PROD=

# =============================================================================
# InitData Validation
# Maximum age (in seconds) for Telegram initData payloads.
# 300 seconds = 5 minutes is a safe default.
# =============================================================================
INITDATA_MAX_AGE_SECONDS_TEST=300
INITDATA_MAX_AGE_SECONDS_PROD=300

# =============================================================================
# Mini App Build-Time Variables (Pages)
# These are baked into the frontend at build time.
# =============================================================================

# Test environment → points to the dev Worker
VITE_API_BASE_URL_TEST=https://api-development.qahal.xyz

# Production environment → points to the prod Worker
VITE_API_BASE_URL_PROD=https://api.qahal.xyz

# Enable profile testing UI in the Mini App (test only)
VITE_ENABLE_PROFILE_TESTING_TEST=true
VITE_ENABLE_PROFILE_TESTING_PROD=false

# =============================================================================
# Cloudflare D1 Database IDs (reference only)
# After creating databases, copy the returned IDs here
# and also update apps/worker/wrangler.toml.
# =============================================================================

# Test database (qahal-db-test)
CF_D1_DATABASE_ID_TEST=

# Production database (qahal-db-prod)
CF_D1_DATABASE_ID_PROD=
